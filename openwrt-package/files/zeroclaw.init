#!/bin/sh /etc/rc.common

# ZeroClaw AI Agent Runtime Init Script
# 用于 OpenWrt/LEDE 系统

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/zeroclaw
CONFIG=/etc/config/zeroclaw
RUN_DIR=/var/run/zeroclaw
LOG_DIR=/var/log/zeroclaw

start_service() {
    mkdir -p "$RUN_DIR" "$LOG_DIR"

    # 从 uci 配置读取设置
    config_load 'zeroclaw'

    config_get_bool enabled config enabled 0
    [ "$enabled" -eq 0 ] && return 1

    config_get user config user 'root'
    config_get config_dir config config_dir '/etc/zeroclaw'
    config_get log_level config log_level 'info'

    mkdir -p "$config_dir"

    procd_open_instance
    procd_set_param command "$PROG" daemon
    procd_set_param respawn
    procd_set_param stderr 1
    procd_set_param stdout 1
    procd_set_param user "$user"

    procd_add_jail_mount "$config_dir" "$RUN_DIR" "$LOG_DIR"
    procd_add_jail_mount_rw /var/run

    procd_set_param env ZEROCLAW_CONFIG_DIR="$config_dir"
    procd_set_param env ZEROCLAW_LOG_LEVEL="$log_level"

    procd_close_instance
}

stop_service() {
    procd_kill 'zeroclaw'
}

reload_service() {
    stop
    start
}

service_triggers() {
    procd_add_reload_trigger 'zeroclaw'
}

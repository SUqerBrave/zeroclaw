# ZeroClaw AI Agent Runtime Configuration
# 放置在 /etc/config/zeroclaw

config zeroclaw 'core'
    option enabled '0'
    option user 'root'
    option config_dir '/etc/zeroclaw'
    option log_level 'info'

    # 网关配置（如果需要）
    # option gateway_host '0.0.0.0'
    # option gateway_port '8080'

    # 默认提供商配置
    # option default_provider 'openai'
    # option model 'gpt-4o-mini'
